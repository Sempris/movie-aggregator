{
  "name": "@ratemix/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types, rating-source catalog, normalization and composite-score math shared by API and web",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "tsdown": "^0.23.0"
  }
}
