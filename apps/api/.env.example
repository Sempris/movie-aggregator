# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Run BullMQ ingestion workers inside the API process (handy for local dev).
# In production run `node dist/worker.js` separately and set this to false.
RUN_WORKERS=true
# Set to true when running behind a reverse proxy (Fly.io, Railway, nginx).
TRUST_PROXY=false

# ─── Infrastructure (matches docker-compose.yml) ────────────────────────────
DATABASE_URL=postgresql://ratemix:ratemix@localhost:5432/ratemix?schema=public
REDIS_URL=redis://localhost:6379

# ─── Frontend / CORS ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ─── Rating sources ─────────────────────────────────────────────────────────
# TMDB: https://www.themoviedb.org/settings/api (v3 API key or v4 read access token)
TMDB_API_KEY=
# OMDb: https://www.omdbapi.com/apikey.aspx (free tier is 1,000 requests/day)
OMDB_API_KEY=
OMDB_DAILY_LIMIT=950
# Share of the daily OMDb budget scheduled refreshes may use; the rest is kept for on-demand fetches.
OMDB_SCHEDULED_SHARE=0.7
# Trakt: https://trakt.tv/oauth/applications (only the client ID is needed)
TRAKT_CLIENT_ID=

# ─── Ingestion schedule ─────────────────────────────────────────────────────
REFRESH_HOURS_HOT=6
REFRESH_HOURS_RECENT=12
REFRESH_HOURS_STABLE=24
SCHEDULER_INTERVAL_MINUTES=60
CATALOG_SYNC_CRON=0 */6 * * *

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Use COOKIE_SECURE=true and COOKIE_SAMESITE=none only if the SPA and API are on different sites.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Public origin that serves /auth/oauth/* (the SPA origin when it proxies to the API).
OAUTH_REDIRECT_BASE_URL=http://localhost:5173
# Optional OAuth providers; the sign-in buttons only appear when both values are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=
