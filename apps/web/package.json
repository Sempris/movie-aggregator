{
  "name": "@ratemix/web",
  "version": "0.1.0",
  "private": true,
  "description": "RateMix single-page app (Vue 3 + Pinia + tRPC client)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@ratemix/shared": "workspace:*",
    "@sentry/vue": "^10.74.0",
    "@trpc/client": "^11.18.0",
    "@vue/devtools-api": "^8.1.5",
    "@vueuse/core": "^14.4.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.10.4",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@ratemix/api": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@trpc/server": "^11.18.0",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.14.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "~8.2.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
